# Copy to terraform.tfvars (gitignored) for local runs.
# In CI these arrive as TF_VAR_* from GitHub variables and secrets instead.
project_id  = "your-project-id"
github_repo = "your-github-user/vitals-platform"
admin_cidr  = "203.0.113.7/32" # curl -s ifconfig.me, then add /32
alert_email = "you@example.com"
